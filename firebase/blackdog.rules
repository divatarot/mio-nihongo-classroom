rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function teacher() {
      return googleUser() && request.auth.token.email == 'blackdogstarball@gmail.com';
    }

    function self(uid) {
      return googleUser() && request.auth.uid == uid;
    }

    function requestPath(uid) {
      return /databases/$(database)/documents/accessRequests/$(uid);
    }

    function studentPath(uid) {
      return /databases/$(database)/documents/students/$(uid);
    }

    function validLesson() {
      return request.resource.data.keys().hasAll([
          'date', 'content', 'feedback', 'nextTopic', 'materials', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'date', 'content', 'feedback', 'nextTopic', 'materials', 'createdAt', 'updatedAt',
          'kind', 'status', 'homework', 'nextPractice', 'goal', 'score', 'before', 'after'
        ])
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 4000
        && request.resource.data.feedback is string
        && request.resource.data.feedback.size() <= 4000
        && request.resource.data.nextTopic is string
        && request.resource.data.nextTopic.size() <= 4000
        && request.resource.data.materials is string
        && request.resource.data.materials.size() <= 4000
        && request.resource.data.get('kind', '正式課') in ['正式課', '試上']
        && request.resource.data.get('status', '已完成') in ['待確認', '已排課', '待補課', '已完成', '已取消']
        && request.resource.data.get('homework', '') is string
        && request.resource.data.get('homework', '').size() <= 4000
        && request.resource.data.get('nextPractice', '') is string
        && request.resource.data.get('nextPractice', '').size() <= 4000
        && request.resource.data.get('goal', '') is string
        && request.resource.data.get('goal', '').size() <= 4000
        && request.resource.data.get('score', 0) is int
        && request.resource.data.get('score', 0) >= 0
        && request.resource.data.get('score', 0) <= 5
        && request.resource.data.get('before', '') is string
        && request.resource.data.get('before', '').size() <= 4000
        && request.resource.data.get('after', '') is string
        && request.resource.data.get('after', '').size() <= 4000
        && request.resource.data.updatedAt == request.time;
    }

    function validPortalDetails() {
      return request.resource.data.keys().hasAll([
          'fee', 'payment', 'discount', 'agreementText', 'agreementStatus',
          'agreementLink', 'agreementVersion', 'speakingProgress', 'scheduleNote', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'fee', 'payment', 'discount', 'agreementText', 'agreementStatus',
          'agreementLink', 'agreementVersion', 'speakingProgress', 'scheduleNote', 'updatedAt'
        ])
        && request.resource.data.fee is string && request.resource.data.fee.size() <= 160
        && request.resource.data.payment is string && request.resource.data.payment.size() <= 160
        && request.resource.data.discount is string && request.resource.data.discount.size() <= 240
        && request.resource.data.agreementText is string && request.resource.data.agreementText.size() <= 4000
        && request.resource.data.agreementStatus is string && request.resource.data.agreementStatus.size() <= 80
        && request.resource.data.agreementLink is string && request.resource.data.agreementLink.size() <= 1200
        && request.resource.data.agreementVersion is string
        && request.resource.data.agreementVersion.size() <= 128
        && request.resource.data.speakingProgress is string && request.resource.data.speakingProgress.size() <= 4000
        && request.resource.data.scheduleNote is string && request.resource.data.scheduleNote.size() <= 4000
        && request.resource.data.updatedAt == request.time;
    }

    function validMessage(uid) {
      return request.resource.data.keys().hasAll([
          'senderUid', 'type', 'body', 'reply', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'senderUid', 'type', 'body', 'reply', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.senderUid == uid
        && request.resource.data.type in ['一般訊息', '請假', '下次教材', '課後回饋']
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2500
        && request.resource.data.reply is string
        && request.resource.data.reply.size() <= 2500
        && request.resource.data.status in ['待回覆', '已回覆']
        && request.resource.data.updatedAt == request.time;
    }

    function validStudent(uid) {
      return request.resource.data.keys().hasAll([
          'uid', 'email', 'name', 'active', 'nextLesson', 'progress',
          'teacherNote', 'homework', 'materials', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'active', 'nextLesson', 'progress',
          'teacherNote', 'homework', 'materials', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.active is bool
        && request.resource.data.nextLesson is string
        && request.resource.data.nextLesson.size() <= 160
        && request.resource.data.progress is string
        && request.resource.data.progress.size() <= 4000
        && request.resource.data.teacherNote is string
        && request.resource.data.teacherNote.size() <= 4000
        && request.resource.data.homework is string
        && request.resource.data.homework.size() <= 4000
        && request.resource.data.materials is string
        && request.resource.data.materials.size() <= 4000
        && request.resource.data.updatedAt == request.time;
    }

    match /accessRequests/{uid} {
      allow get: if self(uid) || teacher();
      allow list: if teacher();
      allow create: if self(uid)
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'status', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if teacher()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['pending', 'approved', 'denied']
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    match /students/{uid} {
      allow get: if teacher() || (self(uid) && resource.data.active == true);
      allow list: if teacher();
      allow create: if teacher()
        && exists(requestPath(uid))
        && validStudent(uid)
        && request.resource.data.email == get(requestPath(uid)).data.email;
      allow update: if teacher()
        && validStudent(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;
      allow delete: if false;

      match /lessons/{lessonId} {
        allow get, list: if teacher() || (self(uid)
          && exists(studentPath(uid))
          && get(studentPath(uid)).data.active == true);
        allow create: if teacher()
          && exists(studentPath(uid))
          && validLesson()
          && request.resource.data.createdAt == request.time;
        allow update: if teacher()
          && validLesson()
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /portalDetails/{detailId} {
        allow get: if detailId == 'summary'
          && (teacher() || (self(uid) && get(studentPath(uid)).data.active == true));
        allow list: if false;
        allow create, update: if detailId == 'summary' && teacher()
          && exists(studentPath(uid)) && validPortalDetails();
        allow delete: if false;
      }

      match /agreementAcknowledgements/{version} {
        allow get, list: if teacher() || (self(uid)
          && get(studentPath(uid)).data.active == true);
        allow create: if self(uid)
          && get(studentPath(uid)).data.active == true
          && exists(/databases/$(database)/documents/students/$(uid)/portalDetails/summary)
          && get(/databases/$(database)/documents/students/$(uid)/portalDetails/summary).data.agreementVersion == version
          && request.resource.data.keys().hasAll(['uid', 'version', 'acceptedAt'])
          && request.resource.data.keys().hasOnly(['uid', 'version', 'acceptedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.version == version
          && request.resource.data.acceptedAt == request.time;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow get, list: if teacher() || (self(uid)
          && get(studentPath(uid)).data.active == true);
        allow create: if self(uid)
          && get(studentPath(uid)).data.active == true
          && validMessage(uid)
          && request.resource.data.reply == ''
          && request.resource.data.status == '待回覆'
          && request.resource.data.createdAt == request.time;
        allow update: if teacher()
          && validMessage(uid)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'status', 'updatedAt']);
        allow delete: if false;
      }
    }

    match /teacherRecords/{uid} {
      allow get, list: if teacher();
      allow create, update: if teacher()
        && request.resource.data.uid == uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /teacherLessonDrafts/{uid}/items/{draftId} {
      allow get, list: if teacher();
      allow create: if teacher()
        && request.resource.data.uid == uid
        && request.resource.data.state == 'draft'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if teacher()
        && resource.data.uid == uid
        && request.resource.data.uid == uid
        && resource.data.state == 'draft'
        && request.resource.data.state in ['draft', 'published']
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /publicPlans/{planId} {
      allow get: if planId == 'pricing';
      allow list: if false;
      allow create, update: if planId == 'pricing' && teacher()
        && request.resource.data.keys().hasAll(['cards', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['cards', 'updatedAt'])
        && request.resource.data.cards is list
        && request.resource.data.cards.size() == 6
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /unlinkedStudentRecords/{recordId} {
      allow get, list: if teacher();
      allow update: if teacher()
        && resource.data.status == 'awaiting_google_identity'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'linkedUid'])
        && request.resource.data.status == 'linked'
        && request.resource.data.linkedUid is string
        && request.resource.data.linkedUid.size() > 0
        && request.resource.data.linkedUid.size() <= 128
        && exists(studentPath(request.resource.data.linkedUid))
        && get(studentPath(request.resource.data.linkedUid)).data.active == true;
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
